import std
let a = 1
std.printf("a = %d\n", a)
let b = 3.14
std.printf("b = %f\n", b)
let c = 1 / 2
std.printf("c = %f\n", c)
let d = a + 2
std.printf("d = %d\n", d)
let e = b + 2.0
std.printf("e = %f\n", e)
let f = c + 1
std.printf("f = %f\n", f)
let i1 = 10 + 20
std.printf("i1 = %d\n", i1)
let i2 = 20 - 10
std.printf("i2 = %d\n", i2)
let i3 = 10 * 20
std.printf("i3 = %d\n", i3)
let i4 = 20 / 5
std.printf("i4 = %d\n", i4)
let i5 = 20 % 3
std.printf("i5 = %d\n", i5)
let i6 = 2 ^ 10
std.printf("i6 = %d\n", i6)
let n1 = 1 + 2.0
std.printf("n1 = %f\n", n1)
let n2 = 2.0 + 1
std.printf("n2 = %f\n", n2)
let n3 = 1 * 2.0
std.printf("n3 = %f\n", n3)
let n4 = 2.0 * 1
std.printf("n4 = %f\n", n4)
let n5 = 1 - 2.0
std.printf("n5 = %f\n", n5)
let n6 = 2.0 - 1
std.printf("n6 = %f\n", n6)
let n7 = 1 / 2.0
std.printf("n7 = %f\n", n7)
let n8 = 2.0 / 1
std.printf("n8 = %f\n", n8)
let n9 = 1 ^ 3
std.printf("n9 = %d\n", n9)
let n10 = 2.0 ^ 3
std.printf("n10 = %f\n", n10)
let r1 = 1 / 2
std.printf("r1 = %f\n", r1)
let r2 = r1 + 1
std.printf("r2 = %f\n", r2)
let r3 = r1 * 2
std.printf("r3 = %f\n", r3)
let r4 = r1 - 1
std.printf("r4 = %f\n", r4)
let inc = |x| -> x + 1
std.printf("inc(10) = %d\n", inc(10))
let double = |x| -> x * 2
std.printf("double(10) = %d\n", double(10))
let square = |x| -> x * x
std.printf("square(5) = %d\n", square(5))
let negate = |x| -> 0 - x
std.printf("negate(10) = %d\n", negate(10))
let f1 = |x| -> x
std.printf("f1(100) = %d\n", f1(100))
let f2 = |x| -> x + 1
std.printf("f2(100) = %d\n", f2(100))
let f3 = |x| -> x * x
std.printf("f3(10) = %d\n", f3(10))
let f4 = |x| -> x + x
std.printf("f4(10) = %d\n", f4(10))
let v1 = inc(10)
std.printf("v1 = %d\n", v1)
let v2 = double(10)
std.printf("v2 = %d\n", v2)
let v3 = square(5)
std.printf("v3 = %d\n", v3)
let v4 = negate(10)
std.printf("v4 = %d\n", v4)
let apply = |f| -> f(10)
let result1 = apply(inc)
std.printf("result1 = %d\n", result1)
let result2 = apply(double)
std.printf("result2 = %d\n", result2)
let result3 = apply(square)
std.printf("result3 = %d\n", result3)
let compose = |f| -> |g| -> |x| -> f(g(x))
let add_one = |x| -> x + 1
let times_two = |x| -> x * 2
let composed = compose(add_one)(times_two)
let result4 = composed(10)
std.printf("result4 = %d\n", result4)
let identity = |x| -> x
let id_int = identity(123)
std.printf("id_int = %d\n", id_int)
let id_real = identity(3.14)
std.printf("id_real = %f\n", id_real)
let id_frac = identity(1 / 2)
std.printf("id_frac = %f\n", id_frac)
let p1 = identity(10)
std.printf("p1 = %d\n", p1)
let p2 = identity(20.0)
std.printf("p2 = %f\n", p2)
let p3 = identity(1 / 3)
std.printf("p3 = %f\n", p3)
let add = |x| -> |y| -> x + y
let add10 = add(10)
let q1 = add10(20)
std.printf("q1 = %d\n", q1)
let q2 = add10(30)
std.printf("q2 = %d\n", q2)
let pow1 = 2 ^ 3
std.printf("pow1 = %d\n", pow1)
let pow2 = 2.0 ^ 3
std.printf("pow2 = %f\n", pow2)
let pow3 = (1 / 2) ^ 3
std.printf("pow3 = %f\n", pow3)
let pow_fn = |x| -> x ^ 2
let pow_result = pow_fn(5)
std.printf("pow_fn(5) = %d\n", pow_result)
let div1 = 10 / 2
std.printf("div1 = %d\n", div1)
let div2 = 10 / 3
std.printf("div2 = %d\n", div2)
let mod1 = 10 % 3
std.printf("mod1 = %d\n", mod1)
let mod2 = 100 % 7
std.printf("mod2 = %d\n", mod2)
let c1 = 1 < 2
std.printf("c1 = %d\n", c1)
let c2 = 2 > 1
std.printf("c2 = %d\n", c2)
let c3 = 1 <= 1
std.printf("c3 = %d\n", c3)
let c4 = 2 >= 1
std.printf("c4 = %d\n", c4)
let c5 = 1 == 1
std.printf("c5 = %d\n", c5)
let c6 = 1 != 2
std.printf("c6 = %d\n", c6)
let less_than = |x| -> x < 10
let cmp1 = less_than(5)
std.printf("cmp1 = %d\n", cmp1)
let cmp2 = less_than(20)
std.printf("cmp2 = %d\n", cmp2)
let float_add = |x| -> x + 1.0
let fa1 = float_add(3.14)
std.printf("fa1 = %f\n", fa1)
let fa2 = float_add(10)
std.printf("fa2 = %f\n", fa2)
let make_adder = |x| -> |y| -> x + y
let add5 = make_adder(5)
let h1 = add5(10)
std.printf("h1 = %d\n", h1)
let h2 = add5(20)
std.printf("h2 = %d\n", h2)
let calc = |x| -> |y| -> |z| -> x + y + z
let calc1 = calc(1)
let calc2 = calc1(2)
let calc3 = calc2(3)
std.printf("calc(1)(2)(3) = %d\n", calc3)
let pipe1 = 10 |> (|x| -> x + 1)
std.printf("pipe1 = %d\n", pipe1)
let pipe2 = 10 |> (|x| -> x * 2)
std.printf("pipe2 = %d\n", pipe2)
let pipe3 = 10 |> (|x| -> x ^ 2)
std.printf("pipe3 = %d\n", pipe3)
let pipe4 =
    10
    |> (|x| -> x + 1)
    |> (|x| -> x * 2)
    |> (|x| -> x ^ 2)
std.printf("pipe4 = %d\n", pipe4)
let make_multiplier = |x| -> |y| -> x * y
let times3 = make_multiplier(3)
let m1 = times3(10)
std.printf("m1 = %d\n", m1)
let m2 = times3(20)
std.printf("m2 = %d\n", m2)
let fn1 = identity
let fn2 = inc
let fn3 = square
let rr1 = fn1(100)
std.printf("rr1 = %d\n", rr1)
let rr2 = fn2(100)
std.printf("rr2 = %d\n", rr2)
let rr3 = fn3(10)
std.printf("rr3 = %d\n", rr3)
let numeric_compose =
    |f| -> |g| -> |x| -> f(g(x))
let plus_one = |x| -> x + 1
let multiply_two = |x| -> x * 2
let pipeline =
    numeric_compose(plus_one)(multiply_two)
let final_value = pipeline(10)
std.printf("final_value = %d\n", final_value)